{
  "name": "@gudupao/astro-i18n",
  "version": "0.0.0",
  "type": "module",
  "description": "Astro i18n plugin with support for {{t.xxx}}, local language packs, language switching, and compatibility with both SSR and SSG.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./plugin": "./dist/plugin.js",
    "./client": "./dist/client.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "astro",
    "i18n",
    "internationalization",
    "localization"
  ],
  "author": "Gudupao",
  "license": "MIT",
  "peerDependencies": {
    "astro": "^2.0.0 || ^3.0.0 || ^4.0.0 || ^5.0.0"
  },
  "dependencies": {
    "cookie": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/cookie": "^0.5.0",
    "typescript": "^5.0.0",
    "astro": "^5.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

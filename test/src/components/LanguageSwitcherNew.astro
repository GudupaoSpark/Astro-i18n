---
interface Props {
 lang?: string; // 在無路徑模式下，這個參數可能是可選的
  pathBasedRouting?: boolean; // 是否使用路徑基於路由的模式
  autoDetectLanguage?: boolean; // 是否自動檢測瀏覽器語言
}

const { lang = 'en', pathBasedRouting = true, autoDetectLanguage = true } = Astro.props;

// 獲取所有可用的語言
const { getAvailableLanguages } = await import('../../../src/translator.js');
const availableLanguages = getAvailableLanguages();
---

<div class="language-switcher">
  <h3>語言切換器 (新版本)</h3>
  <p>當前模式: {pathBasedRouting ? '路徑基於路由' : '無路徑基於路由'}</p>
  <p>瀏覽器語言檢測: {autoDetectLanguage ? '啟用' : '禁用'}</p>
  <div class="switcher-buttons">
    {availableLanguages.map((language) => (
      <button
        data-lang={language}
        class={lang === language ? 'active' : ''}
      >
        {language === 'en' && 'English'}
        {language === 'zh' && '中文'}
        {language === 'jp' && '日本語'}
        {language !== 'en' && language !== 'zh' && language !== 'jp' && language}
      </button>
    ))}
  </div>
</div>

<script is:inline>
// 檢測當前語言的函數
  function detectCurrentLanguage() {
    // 首先檢查 URL 參數
    const urlParams = new URLSearchParams(window.location.search);
    const langParam = urlParams.get('lang');
    if (langParam) return langParam;

    // 然後檢查 Cookie
    const cookies = document.cookie.split(';').reduce((acc, cookie) => {
      const [name, value] = cookie.trim().split('=');
      acc[name] = decodeURIComponent(value);
      return acc;
    }, {});
    
    if (cookies.lang) return cookies.lang;

    // 最後檢查 localStorage
    if (typeof localStorage !== 'undefined') {
      const storedLang = localStorage.getItem('lang');
      if (storedLang) return storedLang;
    }

    // 如果都沒有，返回瀏覽器語言或默認語言
    if (typeof navigator !== 'undefined' && navigator.language) {
      const browserLang = navigator.language.split('-')[0].toLowerCase();
      return browserLang;
    }

    // 默認語言
    return 'en';
  }

// 切換語言的函數
  function switchLanguage(language, pathBasedRouting, autoDetectLanguage) {
    if (pathBasedRouting) {
      // 路徑基於路由的模式
      // 設置語言 Cookie
      document.cookie = `lang=${language}; path=/; max-age=31536000; samesite=lax`;
      console.log('[LanguageSwitcher] 設置語言 Cookie:', language);
      
      const urlParts = window.location.pathname.split('/');
      urlParts[1] = language;
      window.location.href = urlParts.join('/');
    } else {
      // 無路徑基於路由的模式
      // 設置語言 Cookie
      document.cookie = `lang=${language}; path=/; max-age=31536000; samesite=lax`;
      // 設置 localStorage
      if (typeof localStorage !== 'undefined') {
        localStorage.setItem('lang', language);
      }
      // 重新加載頁面以應用新語言
      window.location.reload();
    }
  }

// 為每個按鈕添加點擊事件監聽器
  if (typeof document !== 'undefined' && typeof window !== 'undefined') {
    document.querySelectorAll('.switcher-buttons button').forEach(button => {
      button.addEventListener('click', function() {
        const language = this.getAttribute('data-lang');
        switchLanguage(language, pathBasedRouting, autoDetectLanguage);
      });
    });
  }
</script>

<style>
.language-switcher {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin: 20px 0;
  padding: 15px;
  border: 1px solid #ddd;
  border-radius: 5px;
  background-color: #f9f9f9;
}

.switcher-buttons {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.language-switcher button {
  padding: 8px 12px;
  border: none;
  background: #f0f0f0;
  border-radius: 5px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.language-switcher button:hover {
  background: #e0e0;
}

.language-switcher button.active {
  background: #007bff;
  color: white;
}

.language-switcher h3 {
  margin: 0 0 10px 0;
  font-size: 16px;
 color: #333;
}

.language-switcher p {
  margin: 0 0 10px 0;
  font-size: 14px;
  color: #666;
}
</style>
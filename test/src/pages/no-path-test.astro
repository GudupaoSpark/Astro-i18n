---
import { getTranslator, getTranslations, setCurrentLang } from '../../../src/translator.js';
import Layout from '../layouts/Layout.astro';
import LanguageSwitcherNew from '../components/LanguageSwitcherNew.astro';
import TestVue from '../components/test.vue';

// 檢測當前語言
function detectLanguage() {
  // 首先檢查 URL 參數
  const urlParams = new URLSearchParams(Astro.url.search);
  const langParam = urlParams.get('lang');
  if (langParam) return langParam;

  // 檢查是否在服務器端運行（動態網頁模式）
  if (Astro.request && Astro.request.headers) {
    // 然後檢查 Cookie
    const cookies = Astro.request.headers.get('cookie');
    if (cookies) {
      const cookieObj = Object.fromEntries(
        cookies.split(';').map(cookie => {
          const [name, value] = cookie.trim().split('=');
          return [name, decodeURIComponent(value)];
        })
      );
      if (cookieObj.lang) return cookieObj.lang;
    }
  }

  // 最後檢查 localStorage (在客戶端運行)
  if (typeof window !== 'undefined' && window.localStorage) {
    const storedLang = localStorage.getItem('lang');
    if (storedLang) return storedLang;
  }

  // 如果都沒有，返回瀏覽器語言或默認語言
  if (typeof navigator !== 'undefined' && navigator.language) {
    const browserLang = navigator.language.split('-')[0].toLowerCase();
    return browserLang;
  }

  // 默認語言
  return 'en';
}

// 獲取當前語言
const currentLang = detectLanguage();

// 設置當前語言以供翻譯器使用
setCurrentLang(currentLang);

// 獲取翻譯器
const t = getTranslator();

// 獲取翻譯對象以供客戶端組件使用
const translations = getTranslations();
---

<Layout title={`${t("hello")} - Astro i18n (無路徑模式)`}>
  <div class="debug-info">
    <h1>無路徑多語言模式測試</h1>
    <p>當前語言: {currentLang}</p>
    <p>翻譯測試: {t("hello")}</p>
    <p>翻譯測試: {t("123.a")}</p>
  </div>
  
 <!-- 使用新的語言切換器組件 -->
  <LanguageSwitcherNew lang={currentLang} pathBasedRouting={false} autoDetectLanguage={true} />
  
  <TestVue translations={translations} />
</Layout>

<style>
.debug-info {
  background: #f0f0f0;
  padding: 20px;
  margin-bottom: 20px;
  border-radius: 5px;
}

.debug-info h1 {
  margin-top: 0;
}
</style>
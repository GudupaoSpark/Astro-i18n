---
import { getTranslator, getTranslations } from '../../../src/translator.js';
import Layout from '../layouts/Layout.astro';
import TestAstro from '../components/test.astro';
import TestReact from '../components/test';
import TestVue from '../components/test.vue';

// 支持靜態網頁模式和動態網頁模式
// 在靜態網頁模式下，lang 將從 Astro.params.lang 獲取
// 在動態網頁模式下，可以訪問請求頭來檢測語言
const lang = Astro.params.lang || 'en';
const t = getTranslator(lang);
---

<Layout title={`${t("hello")} - Astro i18n`}>
  <div class="debug-info">
    <p>index Now language: {lang}</p>
    <p>i18n Test: {t("hello")}</p>
  </div>
  
  <TestReact translations={getTranslations(lang)} />
  <TestVue translations={getTranslations(lang)} />
  <TestAstro />
</Layout>

<style>
  .debug-info {
    background: #f0f0f0;
    padding: 10px;
    margin-bottom: 20px;
    border-radius: 5px;
  }
</style>
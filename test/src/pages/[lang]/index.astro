---
import TestAstro from "../../components/test.astro";
import TestReact from "../../components/test.jsx";
import Layout from "../../layouts/Layout.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
import { getTranslator } from "../../../../src/translator";

// 獲取動態路由參數
// 獲取所有支持的語言路徑
export function getStaticPaths() {
  const supportedLangs = ["en", "zh"];
  return supportedLangs.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const currentLang = lang || "en";

// 獲取正確的翻譯函數
const t = getTranslator(currentLang);

// 調試輸出
console.log(`[${currentLang}] 翻譯hello: ${t("hello")}`);
---

<Layout title={`${t("hello")} - Astro i18n`}>
  <div class="debug-info">
    <p>Now language: {currentLang}</p>
    <p>i18n Test: {t("hello")}</p>
  </div>
  <TestReact />
  <TestAstro />
  <LanguageSwitcher lang={currentLang} />
</Layout>

<style>
  .debug-info {
    background: #f0f0f0;
    padding: 10px;
    margin-bottom: 20px;
    border-radius: 5px;
  }
</style>

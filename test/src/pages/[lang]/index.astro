---
import TestAstro from "../../components/test.astro";
import TestReact from "../../components/test.jsx";
import Layout from "../../layouts/Layout.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
import { getTranslator } from "../../../../src/translator";
export { getStaticPaths } from "../../../../src/plugin";

const { lang } = Astro.params;

// 獲取正確的翻譯函數
const t = getTranslator(lang);

// 調試輸出
console.log(`[${lang}] 翻譯hello: ${t("hello")}`);
---

<Layout title={`${t("hello")} - Astro i18n`}>
  <div class="debug-info">
    <p>Now language: {lang}</p>
    <p>i18n Test: {t("hello")}</p>
  </div>
  <TestReact />
  <TestAstro />
  <LanguageSwitcher lang={lang} />
</Layout>

<style>
  .debug-info {
    background: #f0f0f0;
    padding: 10px;
    margin-bottom: 20px;
    border-radius: 5px;
  }
</style>

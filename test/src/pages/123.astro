---
import { getTranslator, getTranslations } from '../../../src/translator.js';
import Layout from '../layouts/Layout.astro';
import TestAstro from '../components/test.astro';
import TestReact from '../components/test';

const lang = Astro.params.lang || 'en';
const t = getTranslator(lang);
---

<Layout title={`${t("hello")} - Astro i18n`}>
  <div class="debug-info">
    <p>123 Now language: {lang}</p>
    <p>i18n Test: {t("hello")}</p>
    <p>i18n Test: {t("123.a")}</p>
  </div>
  
  <TestReact client:load translations={getTranslations(lang)} />
  <TestAstro />
</Layout>

<style>
  .debug-info {
    background: #f0f0f0;
    padding: 10px;
    margin-bottom: 20px;
    border-radius: 5px;
  }
</style>